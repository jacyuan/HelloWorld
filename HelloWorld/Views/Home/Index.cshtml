@model HelloWorld.Models.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="container py-5">
    @if (Model.MaintenanceMode)
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card border-warning shadow-sm">
                    <div class="card-body text-center py-5">
                        <h2 class="text-warning mb-3">Maintenance in Progress</h2>
                        <p class="text-muted mb-0">The site is currently undergoing maintenance. Please check back later.</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center mb-5">
            <h1 class="display-5 fw-bold">Welcome, Yuan</h1>
            <p class="text-muted">Here's your quiz dashboard at a glance.</p>
        </div>

        <div class="row justify-content-center g-4">
            <div class="col-sm-6 col-md-4">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body py-4">
                        <h2 class="display-4 fw-bold text-primary">@Model.QuizCount</h2>
                        <p class="text-muted mb-0">Quizzes</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-md-4">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body py-4">
                        <h2 class="display-4 fw-bold text-success">@Model.QuestionCount</h2>
                        <p class="text-muted mb-0">Questions</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
